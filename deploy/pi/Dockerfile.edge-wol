FROM golang:1.22-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/clubpay-edge-wol ./cmd/edge-wol

FROM alpine:3.20

RUN apk add --no-cache ca-certificates \
    && addgroup -S clubpay \
    && adduser -S -G clubpay clubpay
COPY --from=build /out/clubpay-edge-wol /usr/local/bin/clubpay-edge-wol

USER clubpay
ENTRYPOINT ["/usr/local/bin/clubpay-edge-wol"]
