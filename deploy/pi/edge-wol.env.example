# Do not commit a populated copy of this file.
# The value must be the same as the production GitHub secret EDGE_WOL_TOKEN.
EDGE_WOL_TOKEN=

# Cloud endpoint. It must be WSS, never ws://.
EDGE_WOL_WS_URL=wss://api-clubpay.justix.uz/api/edge/wol/ws

# One permanent ID for this Raspberry Pi and the Club UUID it serves.
EDGE_NODE_ID=pilot-real-network-pi-001
EDGE_CLUB_ID=564ef225-6cdb-4bf9-a362-960f942b3c4d

# Broadcast address of the club LAN.
WOL_BROADCAST_ADDR=255.255.255.255:9
