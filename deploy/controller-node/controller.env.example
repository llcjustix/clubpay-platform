# ClubPay Controller Node. Copy this file to controller.env and fill the values.
# Keep controller.env only on the local node: it contains club and payment secrets.
APP_ENV=production

# edge = primary club controller (Windows Server / Raspberry Pi);
# manager = emergency fallback on the manager's Windows PC.
NODE_MODE=edge
HTTP_ADDR=:8080

# The packaged web directory. A relative path is resolved next to Controller.exe.
WEB_DIR=web
MIGRATIONS_DIR=migrations

# Replace with the actual LAN IP of this node, for example http://192.168.1.10:8080.
PUBLIC_BASE_URL=http://CHANGE-ME:8080
FRONTEND_BASE_URL=http://CHANGE-ME:8080

# Local PostgreSQL runs from postgres-compose.yml. Use only letters/numbers in the password.
LOCAL_POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_LOCAL_PASSWORD
DATABASE_URL=postgres://clubpay:CHANGE_ME_TO_A_LONG_LOCAL_PASSWORD@127.0.0.1:5432/clubpay?sslmode=disable

# These values are issued for the exact club by ClubPay. Do not put production secrets in Git.
CLOUD_BASE_URL=https://api-clubpay.justix.uz
EDGE_SYNC_TOKEN=CHANGE_ME
EDGE_NODE_ID=club-controller-1
EDGE_CLUB_ID=CHANGE_ME_CLUB_UUID

# Agent Core connects directly to this node in a local network.
CORE_MODE=ws
CORE_TOKEN=CHANGE_ME_SHARED_CORE_TOKEN
CORE_TIMEOUT_MS=10000

# Local PC control. Set the correct broadcast address for the club network.
WOL_ENABLED=true
WOL_BROADCAST_ADDR=255.255.255.255:9
WOL_WAIT_SECONDS=60

# Needed to verify Telegram Mini App authorization locally. It is the same bot token as Cloud.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME_BOT_USERNAME
# Keep false for true LAN/offline mode: the QR then opens the local PWA directly.
# A Telegram Mini App has a single BotFather HTTPS URL and cannot load a club-LAN server
# after the public site itself is unavailable.
TELEGRAM_MINI_APP_ENABLED=false
TELEGRAM_POLLING_ENABLED=false

# Keep provider credentials only on a protected primary Controller if direct online payment
# during a cloud outage has been approved by the merchant. Otherwise leave them empty: cash
# and vouchers keep working locally; card checkout is deliberately unavailable offline.
DEFAULT_PAYMENT_PROVIDER=click
MOCK_PAYMENTS_ENABLED=false
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# A manager node starts with cash/vouchers only. Set true only after a separate payment-security review.
MANAGER_ONLINE_PAYMENTS_ENABLED=false
EDGE_SYNC_INTERVAL_SECONDS=15
VOUCHER_MIN_MINUTES=5
VOUCHER_TTL_DAYS=30
SESSION_GRACE_SECONDS=180
