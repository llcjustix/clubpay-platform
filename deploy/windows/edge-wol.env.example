# Do not commit or send the populated file. Ask the ClubPay operator for the token.
EDGE_WOL_TOKEN=

# Cloud endpoint. Must be WSS, never ws://.
EDGE_WOL_WS_URL=wss://api-clubpay.justix.uz/api/edge/wol/ws

# One permanent ID for this server and the UUID of its club.
EDGE_NODE_ID=club-server-001
EDGE_CLUB_ID=

# Usually correct for a flat club LAN. Change only if the club network requires it.
WOL_BROADCAST_ADDR=255.255.255.255:9
