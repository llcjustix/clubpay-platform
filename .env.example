APP_ENV=development
NODE_MODE=cloud
HTTP_ADDR=:8080
DATABASE_URL=postgres://clubpay:clubpay@localhost:5432/clubpay?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
ADMIN_API_TOKEN=
CLOUD_BASE_URL=

DEFAULT_PAYMENT_PROVIDER=mock
MOCK_PAYMENTS_ENABLED=true

CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

PAYME_CHECKOUT_URL=https://test.paycom.uz
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

PLATFORM_FEE_BPS=0
SPLIT_PAYMENTS_ENABLED=false

# mock | http | ws
CORE_MODE=mock
CORE_BASE_URL=http://controller.local:8081
CORE_TOKEN=
CORE_TIMEOUT_MS=10000
# Enable only on the local Controller in the club LAN (edge/manager + CORE_MODE=ws).
WOL_ENABLED=false
WOL_BROADCAST_ADDR=255.255.255.255:9
WOL_WAIT_SECONDS=60

EDGE_SYNC_TOKEN=
EDGE_NODE_ID=
EDGE_CLUB_ID=
EDGE_SYNC_INTERVAL_SECONDS=15

MANAGER_NODE_ID=
MANAGER_CLUB_ID=
MANAGER_ONLINE_PAYMENTS_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Enable only after BotFather has the Main Mini App URL set to
# https://your-frontend-domain/miniapp. Then newly printed static PC QR codes
# open ClubPay inside Telegram.
TELEGRAM_MINI_APP_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_ENABLED=true

VOUCHER_MIN_MINUTES=5
VOUCHER_TTL_DAYS=30
SESSION_GRACE_SECONDS=180
